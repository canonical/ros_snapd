<?xml version="1.0"?>
<package format="2">
<name>ros_snapd</name>
  <version>0.0.1</version>
  <description>This package allows to start/stop snap services from ROS services.</description>

  <maintainer email="ubuntu-robotics@canonical.com">Ubuntu Robotics</maintainer>
  <author email="jeremie.deray@canonical.com">Jeremie Deray</author>

  <license>GPL-3.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>ros_snapd_interfaces</build_depend>
  <build_export_depend>ros_snapd_interfaces</build_export_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>ros_snapd_interfaces</exec_depend>

</package>
